def cmd_run(args: argparse.Namespace) -> int:
    exe = binary(args.backend, args.probe)
    if not exe.exists():
        print(f"{exe} is missing; run ./echolock build first", file=sys.stderr)
        return 2
    pin_cpus = [int(c) for c in args.pin_cpus.split(",") if c.strip()]
    if pin_cpus and not honours_pin_cpus(args.probe, args.backend):
        print(f"--pin-cpus does nothing for {args.probe} on {args.backend}: only sync builds "
              "taskset-wrapped steps, so the run would be unpinned and the record would not say "
              "so. Drop --pin-cpus, or wrap the probe yourself (taskset -c 0 ./build/cuda/memory).",
              file=sys.stderr)
        return 2
    opts = RunOptions(out_root=Path(args.out), label=args.label,
                      load={"name": args.label}, sample_interval_s=args.interval,
                      drop_caches=args.drop_caches)
    extra = args.probe_args
    run_id = new_run_id(args.probe, args.backend, args.label)
    run_dir = opts.out_root / run_id
    plan_opts = PlanOptions(extra=extra, scratch_dir=Path(args.scratch_dir) if args.scratch_dir else None,
                            pin_cpus=pin_cpus,
                            evict_file=args.evict_file)
    run = Run(make_plan(args.probe, args.backend, run_dir, plan_opts), opts, run_id)
    dirs: list[Path] = []
    manifests: list[dict] = []
    for rep in range(max(1, args.repeat)):
        if rep:
            run_dir = opts.out_root / new_run_id(args.probe, args.backend, args.label)
            run = Run(make_plan(args.probe, args.backend, run_dir, plan_opts), opts,
                      run_dir.name)
        print(f"[echolock] {run.run_id}: {len(run.plan.steps)} step(s)", file=sys.stderr)
        try:
            manifest = run.execute()
        except (KeyboardInterrupt, RunInterrupted) as e:
            if dirs and not args.no_report:
                from report.markdown import render
                report = dirs[0] / "report.md" if len(dirs) == 1 else opts.out_root / "report.md"
                report.write_text(render(dirs))
                print(report)
            return aborted(run, e)
        dirs.append(run.dir)
        manifests.append(manifest)
    for manifest in manifests:
        for s in manifest["steps"]:
            print(f"[echolock]   {s['name']}: {s['status']} (rc={s['returncode']}, "
                  f"{(s['end_ns'] - s['start_ns']) / 1e9:.1f} s, {s['failed_checks']} failed checks)",
                  file=sys.stderr)
        kl = manifest["kernel_log"]
        print(f"[echolock] status {manifest['status']}; kernel events during run: "
              f"{kl['during_run'] or 'none'}{'' if kl['available'] else ' (log unavailable: ' + str(kl['error']) + ')'}",
              file=sys.stderr)
    if not args.no_report:
        from report.markdown import render
        report = dirs[0] / "report.md" if len(dirs) == 1 else opts.out_root / "report.md"
        report.write_text(render(dirs))
    print(dirs[0] if len(dirs) == 1 else opts.out_root)
    return 0 if all(m["status"] == "ok" for m in manifests) else 1


def cmd_grid(args: argparse.Namespace) -> int:
    from run.grid import GridOptions, run_grid
    from report.markdown import render
    opts = GridOptions(out_root=Path(args.out), conditions=args.conditions.split(","),
                        settle_s=args.settle, ready_timeout_s=args.ready_timeout,
                        sample_interval_s=args.interval,
                        probe_args=args.probe_args,
                        scratch_dir=Path(args.scratch_dir) if args.scratch_dir else None)
    try:
        dirs = run_grid(args.probe, args.backend, opts)
    except (KeyboardInterrupt, RunInterrupted):
        print("[echolock] grid interrupted; finished run directories are kept", file=sys.stderr)
        return 130
    if not args.no_report:
        (opts.out_root / "grid-report.md").write_text(render(dirs))
        print(opts.out_root / "grid-report.md")
    return 0


def compare_dumps(a_path: Path, b_path: Path, lines: list[str]) -> str:
    """Compares the mma dump files of two backends: operand matrices must be identical, result
    words bit-exact. Only formats both backends dumped can be compared."""
    import json
    out: list[str] = []
    verdicts: list[str] = []
    for tag in ("fp16", "int8"):
        fa, fb = Path(f"{a_path}.{tag}.json"), Path(f"{b_path}.{tag}.json")
        if not fa.exists() or not fb.exists():
            out.append(f"- {tag}: not dumped by both backends (one may not implement the shape)")
            continue
        da, db = json.loads(fa.read_text()), json.loads(fb.read_text())
        operands = da["A"] == db["A"] and da["B"] == db["B"]
        diffs = sum(x != y for x, y in zip(da["D"], db["D"]))
        ok = operands and diffs == 0 and len(da["D"]) == len(db["D"])
        verdicts.append("ok" if ok else "MISMATCH")
        out.append(f"- {tag}: operands {'identical' if operands else 'DIFFER'}, "
                   f"{diffs}/{len(da['D'])} result words differ -> "
                   f"{'bit-exact' if ok else 'NOT bit-exact'}")
    lines += out or ["- no dump files found"]
    if not verdicts:
        return "nothing compared"
    return "all matching" if all(v == "ok" for v in verdicts) else "MISMATCH"


def cmd_crosscheck(args: argparse.Namespace) -> int:
    """Phase 1 of docs/crosscheck.md: run the same probe on two backends of this GPU and put the
    run directories side by side in one report. Each run keeps its own oracle verdict; reading
    the columns next to each other is the point."""
    from report.markdown import render
    backends = [args.backend_a, args.backend_b]
    if args.backend_a == args.backend_b:
        print("crosscheck needs two different backends", file=sys.stderr)
        return 2
    pin_cpus = [int(c) for c in args.pin_cpus.split(",") if c.strip()]
    if pin_cpus and not all(honours_pin_cpus(args.probe, b) for b in backends):
        print("--pin-cpus does nothing for this probe/backend pair (only sync on cuda builds "
              "taskset steps); the crosscheck would compare two unpinned runs", file=sys.stderr)
        return 2
    missing = [b for b in backends if not binary(b, args.probe).exists()]
    if missing:
        print(f"missing binaries for {', '.join(missing)}; run ./echolock build and "
              "make -C backends/vulkan", file=sys.stderr)
        return 2
    opts = RunOptions(out_root=Path(args.out), label=args.label, load={"name": args.label},
                      sample_interval_s=args.interval,
                      drop_caches=args.drop_caches)
    def plan_opts(extra: list[str]) -> PlanOptions:
        return PlanOptions(extra=extra,
                           scratch_dir=Path(args.scratch_dir) if args.scratch_dir else None,
                           pin_cpus=[int(c) for c in args.pin_cpus.split(",") if c],
                           evict_file=args.evict_file)
    per_backend = {args.backend_a: plan_opts(args.a_args.split() if args.a_args else []),
                   args.backend_b: plan_opts(args.b_args.split() if args.b_args else [])}
    # Bit-exact mma comparison: both probes dump operand and result matrices; the comparison runs
    # once both probes are done (the "Bit-exact" section of the report).
    dump = [Path(args.out) / f"bitexact-{b}.dump" for b in backends] if args.bitexact else []
    if dump:
        for b, path in zip(backends, dump):
            per_backend[b].extra += ["--dump-matrix", str(path)]
    dirs: list[Path] = []
    try:
        for b in backends:
            run_id = new_run_id(args.probe, b, args.label)
            run_dir = opts.out_root / run_id
            run = Run(make_plan(args.probe, b, run_dir, per_backend[b]),
                      RunOptions(out_root=Path(args.out), label=args.label,
                                 load={"name": args.label}, sample_interval_s=args.interval,
                                 drop_caches=args.drop_caches),
                      run_id)
            print(f"[echolock] crosscheck {b}: {run.run_id}: {len(run.plan.steps)} step(s)",
                  file=sys.stderr)
            manifest = run.execute()
            dirs.append(run.dir)
            for s in manifest["steps"]:
                print(f"[echolock]   {b} {s['name']}: {s['status']} (rc={s['returncode']}, "
                      f"{(s['end_ns'] - s['start_ns']) / 1e9:.1f} s, {s['failed_checks']} failed checks)",
                      file=sys.stderr)
    except (KeyboardInterrupt, RunInterrupted) as e:
        print(f"[echolock] crosscheck interrupted after {len(dirs)} run(s); keeping them",
              file=sys.stderr)
        if dirs:
            (opts.out_root / "crosscheck-report.md").write_text(render(dirs))
        return interrupt_exit_code(e)
    (opts.out_root / "crosscheck-report.md").write_text(render(dirs))
    # A crosscheck compares backends on one GPU; if the two runs declared different devices, say
    # so loudly (e.g. a Vulkan default device picking an iGPU while CUDA uses the discrete card).
    from report.markdown import RunData
    names = {b: next((d.get("value") for d in RunData(d_).of_type("declared")
                      if d.get("key") == "device.name"), "?")
             for b, d_ in zip(backends, dirs)}
    if len(set(names.values())) > 1:
        print(f"[echolock] WARNING: the two runs used different devices: "
              + "; ".join(f"{b} -> {n}" for b, n in names.items())
              + " -- point both backends at the same GPU (see --a-args/--b-args)", file=sys.stderr)
    if args.check:
        from report.diff import crosscheck_verdicts, render_crosscheck_section
        statuses = [json.loads((d / "manifest.json").read_text()).get("status") for d in dirs]
        if "ok" in statuses and not all(s == "ok" for s in statuses):
            print("[echolock] --check skipped: both runs must finish ok; "
                  f"statuses: {', '.join(str(s) for s in statuses)}", file=sys.stderr)
        else:
            recs = crosscheck_verdicts(dirs[0], dirs[1])
            if recs:
                for d in dirs:
                    with open(d / "crosscheck.jsonl", "a") as f:
                        for r in recs:
                            f.write(json.dumps(r) + "\n")
                (opts.out_root / "crosscheck-report.md").write_text(
                    (opts.out_root / "crosscheck-report.md").read_text()
                    + render_crosscheck_section(recs))
                for r in recs:
                    print(f"[echolock] crosscheck {r['name']}: {r['verdict']} "
                          f"({r['detail']})", file=sys.stderr)
            else:
                print("[echolock] --check: nothing to check (same backend?)", file=sys.stderr)
    if dump:
        lines = ["## Bit-exact", "",
                 "Same operands, same arithmetic, two independent implementations: every result "
                 "word must match bit for bit.", ""]
        verdict = compare_dumps(dump[0], dump[1], lines)
        with open(opts.out_root / "crosscheck-report.md", "a") as f:
            f.write("\n" + "\n".join(lines) + "\n")
        print(f"[echolock] bit-exact: {verdict}", file=sys.stderr)
        if verdict != "all matching":
            return 1
    print(opts.out_root / "crosscheck-report.md")
    return 0


def cmd_report(args: argparse.Namespace) -> int:
    from report.markdown import render
    text = render([Path(d) for d in args.runs])
    if args.out:
        Path(args.out).write_text(text)
    else:
        print(text)
    return 0


def cmd_platforms(args: argparse.Namespace) -> int:
    from report.platforms import main
    return main(args.runs + ([] if not args.out else ["--out", args.out]))


def cmd_export(args: argparse.Namespace) -> int:
    """A self-contained tar.gz of the given run directories: every file of each run, plus a
    content-manifest.json at the archive root (run_id, files with sizes, manifest status)."""
    import tarfile

    runs = []
    for p in args.runs:
        d = Path(p)
        if not (d.is_dir() and (d / "manifest.json").is_file()):
            print(f"{p}: not a run directory (no manifest.json)", file=sys.stderr)
            return 2
        runs.append(d)
    manifest = []
    for d in runs:
        m = json.loads((d / "manifest.json").read_text())
        files = {}
        for f in sorted(d.rglob("*")):
            if f.is_file():
                files[str(f.relative_to(d))] = f.stat().st_size
        manifest.append({"run_id": m.get("run_id"), "dir": d.name,
                         "status": m.get("status"), "files": files})
    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    with tarfile.open(out, "w:gz") as tar:
        data = json.dumps({"v": 1, "runs": manifest}, indent=1).encode()
        info = tarfile.TarInfo("content-manifest.json")
        info.size = len(data)
        info.mtime = int(time.time())
        tar.addfile(info, io.BytesIO(data))
        for d in runs:
            tar.add(d, arcname=d.name)
    print(out)
    return 0


def cmd_diff(args: argparse.Namespace) -> int:
    from report.diff import diff_runs, render_diff
    a, b = Path(args.a), Path(args.b)
    for d in (a, b):
        if not (d.is_dir() and (d / "manifest.json").is_file()):
            print(f"{d}: not a run directory (no manifest.json)", file=sys.stderr)
            return 2
    diff = diff_runs(a, b, args.tol)
    text = render_diff(diff)
    if args.out:
        Path(args.out).write_text(text)
        print(args.out, file=sys.stderr)
    else:
        print(text)
    return diff.exit_code


def cmd_regress(args: argparse.Namespace) -> int:
    """diff a new run against --against, or against the auto baseline: the most recent run
    with the same probe, backend, label and declared device."""
    from report.diff import candidates_for, diff_runs, find_baseline, render_diff
    new = Path(args.new)
    if not (new.is_dir() and (new / "manifest.json").is_file()):
        print(f"{new}: not a run directory (no manifest.json)", file=sys.stderr)
        return 2
    if args.against:
        base = Path(args.against)
        if not (base.is_dir() and (base / "manifest.json").is_file()):
            print(f"{base}: not a run directory (no manifest.json)", file=sys.stderr)
            return 2
    else:
        base = find_baseline(new, Path(args.runs))
        if base is None:
            print("no baseline: same probe + backend + label + declared device not found "
                  f"under {args.runs}; candidates:", file=sys.stderr)
            for rd in candidates_for(new, Path(args.runs)):
                print(f"  {rd.dir.name}  ({rd.manifest.get('label')} @ "
                      f"{rd.manifest.get('started_utc')})", file=sys.stderr)
            return 2
        print(f"[echolock] baseline: {base}", file=sys.stderr)
    diff = diff_runs(base, new, args.tol)
    text = render_diff(diff)
    if args.out:
        Path(args.out).write_text(text)
        print(args.out, file=sys.stderr)
    else:
        print(text)
    return diff.exit_code


def cmd_suite(args: argparse.Namespace) -> int:
    from run.suite import run_suite
    backends = tuple(args.backends.split(","))
    for b in backends:
        if b not in ("cuda", "vulkan"):
            print(f"unknown backend {b!r} (have: cuda, vulkan)", file=sys.stderr)
            return 2
    conditions = tuple(args.conditions.split(","))
    try:
        report = run_suite(backends=backends, conditions=conditions,
                           out_root=Path(args.out), probe_args=args.probe_args)
    except (KeyboardInterrupt, RunInterrupted):
        print("[echolock] suite interrupted; finished run directories are kept", file=sys.stderr)
        return 130
    except ValueError as e:  # an unknown load condition
        print(str(e), file=sys.stderr)
        return 2
    print(report)
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="echolock", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    b = sub.add_parser("build", help="build the CUDA probes")
    b.add_argument("--arch", default=None,
                   help="sm_121a by default; sm_120a is picked automatically on a CC 12.0 GPU")
    b.add_argument("--nvcc")
    b.set_defaults(fn=cmd_build)

    sub.add_parser("env", help="print the environment snapshot").set_defaults(fn=cmd_env)

    s = sub.add_parser("sample", help="stream environment samples")
    s.add_argument("--interval", type=float, default=1.0)
    s.add_argument("--duration", type=float, default=0)
    s.set_defaults(fn=cmd_sample)

    sub.add_parser("kmsg", help="stream kernel-log events").set_defaults(fn=cmd_kmsg)

    r = sub.add_parser("run", help="run a probe")
    r.add_argument("probe", choices=PROBES)
    r.add_argument("--backend", default="cuda", choices=BACKENDS)
    r.add_argument("--label", default="idle", help="load condition name for this run")
    r.add_argument("--out", default=str(ROOT / "runs"))
    r.add_argument("--interval", type=float, default=1.0, help="sampler interval, s")
    r.add_argument("--drop-caches", action="store_true",
                   help="drop the page cache before steps that don't manage page residency "
                        "themselves (root or passwordless sudo)")
    r.add_argument("--scratch-dir", help="file_page: directory for the scratch file (not tmpfs)")
    r.add_argument("--evict-file", help="file_page: evict by reading this >RAM file instead of fadvise")
    r.add_argument("--pin-cpus", default="", help="sync: also run blocking pinned to these CPUs, e.g. 0,10")
    r.add_argument("--no-report", action="store_true")
    r.add_argument("--repeat", type=int, default=1, metavar="N",
                   help="run the probe N times (separate run directories, one report)")
    r.set_defaults(fn=cmd_run)

    r = sub.add_parser("grid", help="run a probe under each load condition")
    r.add_argument("probe", choices=PROBES)
    r.add_argument("--backend", default="cuda", choices=BACKENDS)
    r.add_argument("--conditions", default="idle",
                   help="comma list: idle, cpu50, mem80, io500, gpu50")
    r.add_argument("--out", default=str(ROOT / "runs"))
    r.add_argument("--interval", type=float, default=1.0, help="sampler interval, s")
    r.add_argument("--settle", type=float, default=2.0, help="s to wait after the load is ready")
    r.add_argument("--ready-timeout", type=float, default=300.0,
                   help="s to wait for the load's ready record (memfill needs this)")
    r.add_argument("--scratch-dir")
    r.add_argument("--no-report", action="store_true")
    r.set_defaults(fn=cmd_grid)

    rep = sub.add_parser("crosscheck", help="run one probe on two backends and report side by side")
    rep.add_argument("probe", choices=PROBES)
    rep.add_argument("--backend-a", default="cuda", choices=BACKENDS)
    rep.add_argument("--backend-b", default="vulkan", choices=BACKENDS)
    rep.add_argument("--label", default="idle", help="load condition name for both runs")
    rep.add_argument("--out", default=str(ROOT / "runs"))
    rep.add_argument("--interval", type=float, default=1.0, help="sampler interval, s")
    rep.add_argument("--drop-caches", action="store_true")
    rep.add_argument("--scratch-dir")
    rep.add_argument("--evict-file")
    rep.add_argument("--pin-cpus", default="")
    rep.add_argument("--a-args", help="probe arguments for backend A, quoted")
    rep.add_argument("--b-args", help="probe arguments for backend B, quoted")
    rep.add_argument("--check", action="store_true",
                     help="apply the phase-3 invariants (docs/crosscheck.md) after both runs: "
                          "verdicts as crosscheck records in both run dirs and a section in "
                          "the report")
    rep.add_argument("--bitexact", action="store_true",
                     help="mma: dump operands/results on both backends and require bit equality")
    rep.set_defaults(fn=cmd_crosscheck)

    pl = sub.add_parser("platforms", help="platforms.md: one row per GPU/backend from run dirs")
    pl.add_argument("runs", nargs="*", help="run directories; default: every run under runs/")
    pl.add_argument("--out", default=str(ROOT / "docs" / "platforms.md"))
    pl.set_defaults(fn=cmd_platforms)

    rep = sub.add_parser("report", help="Markdown report for run directories")
    rep.add_argument("runs", nargs="+")
    rep.add_argument("--out")
    rep.set_defaults(fn=cmd_report)

    e = sub.add_parser("export", help="tar.gz a run directory with a content manifest")
    e.add_argument("runs", nargs="+", help="run directories")
    e.add_argument("--out", required=True, help="archive path (.tar.gz)")
    e.set_defaults(fn=cmd_export)

    d = sub.add_parser("diff", help="diff two run directories on the canonical metrics")
    d.add_argument("a", help="run directory A (baseline)")
    d.add_argument("b", help="run directory B (new)")
    d.add_argument("--tol", type=float, default=0.1, help="relative tolerance (default 0.1)")
    d.add_argument("--out", help="write the report to FILE instead of stdout")
    d.set_defaults(fn=cmd_diff)

    g = sub.add_parser("regress", help="diff a run against its baseline")
    g.add_argument("new", help="the run to check")
    g.add_argument("--against", default=None,
                   help="baseline run directory (default: most recent run with the same "
                        "probe + backend + label + declared device)")
    g.add_argument("--runs", default=str(ROOT / "runs"), help="run root to search (default runs/)")
    g.add_argument("--tol", type=float, default=0.1, help="relative tolerance (default 0.1)")
    g.add_argument("--out", help="write the report to FILE instead of stdout")
    g.set_defaults(fn=cmd_regress)

    s = sub.add_parser("suite", help="every probe x backend with a built binary, under each condition")
    s.add_argument("--backends", default="cuda,vulkan",
                   help="comma list of backends to sweep (default cuda,vulkan)")
    s.add_argument("--conditions", default="idle",
                   help="comma list of load conditions (default idle)")
    s.add_argument("--out", default=str(ROOT / "runs"), help="run root for the run dirs and report")
    s.set_defaults(fn=cmd_suite)

    # Everything after a bare "--" goes to the probe untouched.
    argv = sys.argv[1:]
    probe_args: list[str] = []
    if "--" in argv:
        cut = argv.index("--")
        argv, probe_args = argv[:cut], argv[cut + 1:]
    args = ap.parse_args(argv)
    args.probe_args = probe_args
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
