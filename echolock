#!/usr/bin/env python3
"""echolock: measure what an edge GPU does, not what it declares.

  ./echolock build [--arch sm_121a]            build the CUDA probes into build/cuda/
  ./echolock env                               print the environment snapshot (JSON)
  ./echolock sample [--duration S]             stream 1 s environment samples (JSONL)
  ./echolock kmsg                              stream kernel-log GPU/OOM/hang events (JSONL)
  ./echolock run PROBE [options] [-- ARGS]     run a probe with env capture -> runs/<run_id>/
  ./echolock report RUN_DIR... [--out FILE]    Markdown report; several runs side by side
  ./echolock platforms [--runs DIR] [--out F]  generate docs/platforms.md from the run corpus
  ./echolock export RUNS... --out FILE.tar.gz  self-contained archive + content manifest
  ./echolock diff A B [--tol 0.1] [--out F]    per canonical metric: both values, delta, verdict
  ./echolock regress NEW [--against BASE]      diff against the auto-selected baseline
  ./echolock suite [--backends] [--conditions] every probe x backend under each condition
  ./echolock crosscheck PROBE [--check]        two backends side by side (+ phase-3 invariants)
"""

from __future__ import annotations

import argparse
import io
import json
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))

from run.plans import (BACKENDS, PROBES, PlanOptions, binary, honours_pin_cpus,  # noqa: E402
                       make_plan)
from run.runner import (Run, RunInterrupted, RunOptions, interrupt_exit_code,  # noqa: E402
                        new_run_id)


def aborted(run: Run, exc: BaseException) -> int:
    """Ends a run that a signal cut short. The steps that finished are still usable: the manifest
    and every stream up to the interrupt are on disk, and the step's process group was stopped."""
    where = str(run.dir) if run.dir.exists() else "no run directory was created"
    print(f"[echolock] interrupted by {run.interrupted or type(exc).__name__}; "
          f"partial run in {where}", file=sys.stderr)
    return interrupt_exit_code(exc)


def cmd_build(args: argparse.Namespace) -> int:
    arch = args.arch or detect_arch()
    cmd = ["make", "-C", str(ROOT / "backends" / "cuda"), f"ARCH={arch}"]
    if args.nvcc:
        cmd.append(f"NVCC={args.nvcc}")
    return subprocess.call(cmd)


def detect_arch() -> str:
    """ARCH for this machine's GPU: the family-specific target when the GPU is Blackwell (fp4 MMA
    needs the 'a' target), sm_121a (the GB10 default) when no GPU answers."""
    try:
        p = subprocess.run(["nvidia-smi", "--query-gpu=compute_cap", "--format=csv,noheader"],
                           capture_output=True, text=True, timeout=20)
        cap = p.stdout.strip().splitlines()[0].strip() if p.returncode == 0 and p.stdout.strip() else ""
    except (OSError, subprocess.TimeoutExpired):
        cap = ""
    if cap == "12.0":
        print("[echolock] GPU compute capability 12.0: building sm_120a (pass --arch to override)",
              file=sys.stderr)
        return "sm_120a"
    return "sm_121a"


